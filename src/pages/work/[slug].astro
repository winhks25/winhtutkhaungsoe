---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import Icon from '../../components/Icon.astro';
import Contact from '../../components/Contact.astro';
import { projects, type Project } from '../../data/portfolio';
import { localPath } from '../../utils/paths';
import ProjectDetails from '../../components/projects/ProjectDetails.astro';
import { projectText } from '../../data/project-details';
import '../../styles/case-study.css';
export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
---

<BaseLayout
  title={`${project.name} — Win Htut Khaung Soe`}
  description={
    'details' in project
      ? projectText(project.details.overview)
      : project.description
  }
>
  {'details' in project ? (
    <ProjectDetails name={project.name} content={project.details} />
  ) : (
    <>
      <section class="case-intro container" aria-labelledby="project-heading">
        <a class="text-link case-back" href={`${localPath()}#work`}>
          <Icon name="arrow-left" size={17} /> All projects
        </a>
        <div class="eyebrow section-label">
          <span>{project.number} /</span> {project.category}
        </div>
        <h1 id="project-heading">
          {project.name}
          <span>.</span>
        </h1>
        <p class="case-headline">{project.headline}</p>
        <div class="case-meta">
          <div>
            <span class="eyebrow">MY ROLE</span>
            <span>{project.role}</span>
          </div>
          <div>
            <span class="eyebrow">TIMELINE</span>
            <span>{project.period}</span>
          </div>
          <div>
            <span class="eyebrow">
              {project.plan ? 'PLANNED STACK' : 'BUILT WITH'}
            </span>
            <span>{project.stack.join(' · ')}</span>
          </div>
          {project.repository && (
            <a
              class="button button-outline"
              href={project.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              View repository <Icon name="arrow-up-right" size={17} />
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )}
        </div>
        {project.plan && (
          <aside
            class="project-plan-summary"
            aria-label="Project status and team"
          >
            <div>
              <span class="eyebrow">CURRENT STATUS</span>
              <p>{project.plan.status}</p>
            </div>
            <div>
              <span class="eyebrow">MVP TARGET</span>
              <p>{project.plan.target}</p>
            </div>
            <div class="project-plan-team">
              <span class="eyebrow">
                THE TEAM · {project.plan.team.length} MEMBERS
              </span>
              <ul>
                {project.plan.team.map((member) => (
                  <li>{member}</li>
                ))}
              </ul>
            </div>
          </aside>
        )}
        <div class="case-art">
          <ProjectArtwork variant={project.slug} />
        </div>
      </section>
      <section class="case-body container" aria-labelledby="context-heading">
        <div class="case-section">
          <div class="eyebrow">THE CONTEXT</div>
          <div>
            <h2 id="context-heading">
              Built around <em>people.</em>
            </h2>
            <p>{project.context}</p>
          </div>
        </div>
        {project.plan && (
          <section
            class="case-section"
            aria-labelledby="planned-features-heading"
          >
            <div class="eyebrow">PLANNED EXPERIENCE</div>
            <div>
              <h2 id="planned-features-heading">
                Quick to record. Clear to review.
              </h2>
              <p>
                The proposed workflow pairs CLI-first commands for fast entry
                with a GUI for browsing recorded client data. These features are
                being scoped during ideation.
              </p>
              <figure class="project-command">
                <figcaption class="eyebrow">PROPOSED COMMAND</figcaption>
                <code>{project.plan.command}</code>
                <p>{project.plan.commandDescription}</p>
              </figure>
              <div class="project-plan-features">
                {project.plan.features.map((feature) => (
                  <article>
                    <h3>{feature.title}</h3>
                    <p>{feature.description}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )}
        <div class="case-section">
          <div class="eyebrow">MY CONTRIBUTIONS</div>
          <div class="contributions">
            {project.contributions.map((item, index) => (
              <article>
                <span class="contribution-number">0{index + 1}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="case-section case-focus">
          <div class="eyebrow">
            {project.plan ? 'TECHNICAL DIRECTION' : 'TECHNICAL FOCUS'}
          </div>
          <p>{project.focus}</p>
        </div>
      </section>
    </>
  )}
  <div class="container next-project">
    <span class="eyebrow">NEXT PROJECT</span>
    <a href={localPath(`work/${next.slug}/`)}>
      {next.name}
      <Icon name="arrow-up-right" size={36} />
    </a>
  </div>
  <Contact />
</BaseLayout>

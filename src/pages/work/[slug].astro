---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Contact from '../../components/Contact.astro';
import { projects, type Project } from '../../data/portfolio';
import { localPath } from '../../utils/paths';
import ProjectDetails from '../../components/projects/ProjectDetails.astro';
import { projectText } from '../../data/project-details';
export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
---

<BaseLayout
  title={`${project.name} — Win Htut Khaung Soe`}
  description={projectText(project.details.overview)}
>
  <ProjectDetails name={project.name} content={project.details} />
  <div class="container next-project">
    <span class="eyebrow">NEXT PROJECT</span>
    <a href={localPath(`work/${next.slug}/`)}>
      {next.name}
      <Icon name="arrow-up-right" size={36} />
    </a>
  </div>
  <Contact />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import Contact from '../components/Contact.astro';
import { profile, projects, experience, skills } from '../data/portfolio';
import { localPath } from '../utils/paths';
const [featured, ...otherProjects] = projects;
---

<BaseLayout isHome>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-content">
      <div class="eyebrow hero-eyebrow">
        <span class="status-dot"></span> HELLO, I’M WIN
      </div>
      <h1 id="hero-heading">
        Thoughtful code.
        <br />
        <em>Human impact.</em>
      </h1>
      <p class="hero-description">
        I’m Win Htut Khaung Soe — an AI student at NUS, developer, and community
        builder. I turn curiosity into software that brings people together.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work <Icon name="arrow-down" size={18} />
        </a>
        <a class="text-link" href="#about">
          A little about me <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="hero-location">
        <span>
          <Icon name="pin" size={15} /> Based in Singapore
        </span>
        <i></i>
        <span>Currently learning. Always building.</span>
      </div>
    </div>
    <HeroPortrait />
  </section>

  <div class="intro-strip container">
    <span>DEVELOPER BY CURIOSITY. COMMUNITY BUILDER AT HEART.</span>
    <span>
      SCROLL TO EXPLORE <Icon name="arrow-down" size={14} />
    </span>
  </div>

  <section
    id="work"
    class="work-section section container"
    aria-labelledby="work-heading"
  >
    <div class="section-heading">
      <div>
        <div class="eyebrow section-label">
          <span>01 /</span> SELECTED WORK
        </div>
        <h2 id="work-heading">
          My <em>Projects.</em>
        </h2>
      </div>
      <p>
        A few things I’ve been building.
        <br />
        Each one starts with people.
      </p>
    </div>
    <article class="featured-project">
      <div class="featured-description">
        <div class="eyebrow project-category">{featured.category}</div>
        <h3>
          <a href={localPath(`work/${featured.slug}/`)}>{featured.name}</a>
        </h3>
        <p class="project-headline">{featured.headline}</p>
        <p class="project-description">{featured.description}</p>
        <ul class="tech-tags" aria-label="Technologies">
          {featured.stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
        <a class="project-link" href={localPath(`work/${featured.slug}/`)}>
          Explore project <Icon name="arrow-up-right" size={19} />
          <span class="sr-only">: {featured.name}</span>
        </a>
        <span class="project-index">PROJECT / {featured.number}</span>
      </div>
      <a
        class="art-link"
        href={localPath(`work/${featured.slug}/`)}
        aria-label={`Explore ${featured.name}`}
      >
        <ProjectArtwork variant={featured.slug} />
      </a>
    </article>
    <div class="project-grid">
      {otherProjects.map((project) => (
        <article class="project-card">
          <a
            class="art-link"
            href={localPath(`work/${project.slug}/`)}
            aria-label={`Explore ${project.name}`}
          >
            <ProjectArtwork variant={project.slug} />
          </a>
          <div class="project-card-info">
            <div class="eyebrow project-category">
              {project.category}
              <span>{project.number}</span>
            </div>
            <h3>
              <a href={localPath(`work/${project.slug}/`)}>
                {project.name}
                <Icon name="arrow-up-right" size={24} />
              </a>
            </h3>
            <p>{project.description}</p>
            <ul class="tech-tags" aria-label="Technologies">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <div class="work-footnote">
      <span>Built with curiosity, improved with every iteration.</span>
      <a
        class="text-link"
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        More on GitHub <Icon name="arrow-up-right" size={17} />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section
    id="about"
    class="about-section section"
    aria-labelledby="about-heading"
  >
    <div class="container about-grid">
      <div class="about-intro">
        <div class="eyebrow section-label">
          <span>02 /</span> A LITTLE ABOUT ME
        </div>
        <h2 id="about-heading">
          Who
          <br />
          the <em>Am I?</em>
        </h2>
        <p class="about-lead">
          I like understanding how things work.
          <br />I care even more about who they work for.
        </p>
        <div class="flex flex-row">
          <p>I am</p>
          <div class="about-signature">Win Htut Khaung Soe</div>
        </div>
      </div>
      <div class="about-content">
        <p>
          I’m studying{' '}
          <strong>
            Artificial Intelligence at the National University of Singapore
          </strong>
          . My work spans full-stack web development, desktop applications, and
          the small details that make an interface feel right.
        </p>
        <p>
          Beyond the screen, you’ll find me mentoring students in Java, helping
          build a welcoming residential community, or bringing people together
          through the Myanmar Community at NUS.
        </p>
        <p>
          Whether it’s a line of code or a conversation, I’m drawn to work that
          makes someone’s day a little better.
        </p>
        <div class="education-card">
          <div class="education-icon">
            NUS<span>↗</span>
          </div>
          <div>
            <span class="eyebrow">EDUCATION</span>
            <h3>Bachelor of Computing in Artificial Intelligence</h3>
            <p>National University of Singapore</p>
            <span class="education-date">
              2025 – 2029 <i>·</i> GPA 4.19 / 5.00
            </span>
          </div>
        </div>
      </div>
    </div>
    <div class="container skills-section">
      <div class="eyebrow">MY EVERYDAY TOOLKIT</div>
      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    id="experience"
    class="experience-section section container"
    aria-labelledby="experience-heading"
  >
    <div class="section-heading">
      <div>
        <div class="eyebrow section-label">
          <span>03 /</span> LEARNING, LEADING, GIVING BACK
        </div>
        <h2 id="experience-heading">
          My
          <br />
          <em>Leadership & Extra-curriculars.</em>
        </h2>
      </div>
      <a
        class="text-link"
        href={localPath('resume.pdf')}
        download="Win-Htut-Khaung-Soe-Resume.pdf"
      >
        Download résumé <Icon name="arrow-down" size={18} />
        <span class="sr-only"> (PDF)</span>
      </a>
    </div>
    <div class="experience-list">
      {experience.map((item) => (
        <article class="experience-item">
          <div class="experience-date">
            {item.period}
            <span class="experience-tag">{item.tag}</span>
          </div>
          <div class="experience-role">
            <h3>{item.title}</h3>
            <span>{item.organization}</span>
          </div>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>
  <Contact />
</BaseLayout>

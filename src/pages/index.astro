---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import Contact from '../components/Contact.astro';
import { profile, projects, experience, skills } from '../data/portfolio';
import { localPath } from '../utils/paths';
const [featured, ...otherProjects] = projects;
---

<BaseLayout isHome>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-content">
      <div class="eyebrow hero-eyebrow">
        <span class="status-dot"></span> HELLO, I’M
      </div>
      <h1 id="hero-heading">
        Win Htut
        <em> Khaung Soe.</em>
      </h1>
      <p class="hero-description">
        I'm an Artificial Intelligence undergraduate at the National University
        of Singapore (NUS), passionate about building meaningful solutions
        through technology. As a developer, I enjoy turning ideas into
        real-world applications, tackling complex challenges, and exploring new
        technologies to continuously expand my skills.
        <br /> <br />
        Beyond development, I enjoy being actively involved in my communities,
        connecting with people from diverse backgrounds, and learning from their
        experiences. I'm also passionate about leadership, mentorship, and
        contributing to the communities I'm part of.
        <br /> <br />
        My experiences as a Teaching Assistant, Residential Assistant, and
        student leader have strengthened my belief in the importance of
        collaboration, communication, and empowering others to grow and succeed.
        <br /> <br />I aspire to grow into a well-rounded developer who not only
        builds impactful technology but also brings people together and
        contributes meaningfully to society.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">
          Explore my work.
        </a>
        <a class="text-link" href="#contact">
          Contact. <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <div class="hero-location">
        <span>
          <Icon name="pin" size={15} /> Based in Singapore
        </span>
        <i></i>
        <span>Currently learning. Always building.</span>
      </div>
    </div>
    <HeroPortrait />
    <div class="skills-grid hero-skills">
      {skills.map((group) => (
        <div class="skill-group">
          <h3>{group.label}</h3>
          <ul>
            {group.items.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <div class="intro-strip container">
    <span>DEVELOPER BY CURIOSITY. COMMUNITY BUILDER AT HEART.</span>
    <span>
      SCROLL TO EXPLORE <Icon name="arrow-down" size={14} />
    </span>
  </div>

  <section
    id="work"
    class="work-section section container"
    aria-labelledby="work-heading"
  >
    <div class="section-heading">
      <div>
        <div class="eyebrow section-label">
          <span>01 /</span> SELECTED WORK
        </div>
        <h2 id="work-heading">
          My <em>Projects.</em>
        </h2>
      </div>
      <p>
        A few things I’ve been building.
        <br />
        Each one starts with people.
      </p>
    </div>
    <article class="featured-project">
      <div class="featured-description">
        <div class="eyebrow project-category">{featured.category}</div>
        <h3>
          <a href={localPath(`work/${featured.slug}/`)}>{featured.name}</a>
        </h3>
        <p class="project-headline">{featured.headline}</p>
        <p class="project-description">{featured.description}</p>
        <ul class="tech-tags" aria-label="Technologies">
          {featured.stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
        <a class="project-link" href={localPath(`work/${featured.slug}/`)}>
          Explore project <Icon name="arrow-up-right" size={19} />
          <span class="sr-only">: {featured.name}</span>
        </a>
        <span class="project-index">PROJECT / {featured.number}</span>
      </div>
      <a
        class="art-link"
        href={localPath(`work/${featured.slug}/`)}
        aria-label={`Explore ${featured.name}`}
      >
        <ProjectArtwork variant={featured.slug} />
      </a>
    </article>
    <div class="project-grid">
      {otherProjects.map((project) => (
        <article class="project-card">
          <a
            class="art-link"
            href={localPath(`work/${project.slug}/`)}
            aria-label={`Explore ${project.name}`}
          >
            <ProjectArtwork variant={project.slug} />
          </a>
          <div class="project-card-info">
            <div class="eyebrow project-category">
              {project.category}
              <span>{project.number}</span>
            </div>
            <h3>
              <a href={localPath(`work/${project.slug}/`)}>
                {project.name}
                <Icon name="arrow-up-right" size={24} />
              </a>
            </h3>
            <p>{project.description}</p>
            <ul class="tech-tags" aria-label="Technologies">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <div class="work-footnote">
      <span>Built with curiosity, improved with every iteration.</span>
      <a
        class="text-link"
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        More on GitHub <Icon name="arrow-up-right" size={17} />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section
    id="experience"
    class="experience-section section container"
    aria-labelledby="experience-heading"
  >
    <div class="section-heading">
      <div>
        <div class="eyebrow section-label">
          <span>02 /</span> LEARNING, LEADING, GIVING BACK
        </div>
        <h2 id="experience-heading">
          <em>Leadership & Extra-curriculars.</em>
        </h2>
      </div>
      <a
        class="text-link"
        href={localPath('resume.pdf')}
        download="Win-Htut-Khaung-Soe-Resume.pdf"
      >
        Download résumé <Icon name="arrow-down" size={18} />
        <span class="sr-only"> (PDF)</span>
      </a>
    </div>
    <div class="experience-list">
      {experience.map((item) => (
        <article class="experience-item">
          <div class="experience-date">
            {item.period}
            <span class="experience-tag">{item.tag}</span>
          </div>
          <div class="experience-role">
            <h3>{item.title}</h3>
            <span>{item.organization}</span>
          </div>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>
  <Contact />
</BaseLayout>

<style>
  .hero-skills {
    grid-column: 1 / -1;
    margin-top: 0;
  }
</style>

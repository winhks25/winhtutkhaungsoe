---
import { Image } from 'astro:assets';
import portrait from '../assets/win-portrait.jpg';
---

<figure class="hero-portrait">
  <div class="portrait-frame">
    <Image
      src={portrait}
      alt="Win Htut Khaung Soe smiling beside Singapore’s waterfront at night"
      width={800}
      height={1000}
      widths={[320, 480, 640, 800, 960]}
      sizes="(max-width: 760px) min(100vw - 48px, 360px), (max-width: 1100px) 40vw, 480px"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <figcaption>
    <span class="portrait-name">Win Htut Khaung Soe</span>
    <span class="portrait-description">Developer · Community builder</span>
  </figcaption>
</figure>

<style>
  .hero-portrait {
    width: 100%;
    max-width: 480px;
    margin: 0;
    padding: 12px 12px 0;
    justify-self: end;
    background: var(--sage);
    border: 1px solid var(--line);
    border-radius: 26px;
  }

  .portrait-frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 17px;
    background: var(--surface);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  figcaption {
    display: grid;
    gap: 3px;
    padding: 18px 8px 20px;
    line-height: 1.6;
  }

  .portrait-name {
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
  }

  .portrait-description {
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .hero-portrait {
      max-width: 360px;
      justify-self: center;
      padding: 9px 9px 0;
      border-radius: 22px;
    }

    .portrait-frame {
      aspect-ratio: 1;
      border-radius: 14px;
    }

    .portrait-frame img {
      object-position: center 38%;
    }

    figcaption {
      padding: 14px 7px 16px;
    }
  }

  @media print {
    .hero-portrait {
      display: none;
    }
  }
</style>

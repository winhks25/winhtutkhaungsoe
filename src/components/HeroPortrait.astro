---
import { Image } from 'astro:assets';
import portrait from '../assets/win-portrait-cutout.png';
---

<div class="hero-portrait">
  <Image
    src={portrait}
    alt="Win Htut Khaung Soe smiling, with a torn-paper outline"
    widths={[320, 480, 640, 800, 960]}
    sizes="(max-width: 760px) 300px, (max-width: 1100px) 38vw, 440px"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .hero-portrait {
    width: 100%;
    max-width: 440px;
    justify-self: center;
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 5px 4px rgb(20 32 25 / 12%));
  }

  @media (max-width: 760px) {
    .hero-portrait {
      max-width: 300px;
    }
  }

  @media print {
    .hero-portrait {
      display: none;
    }
  }
</style>

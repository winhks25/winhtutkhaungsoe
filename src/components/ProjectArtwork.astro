---
import type { Project } from '../data/portfolio';
import { Image } from 'astro:assets';
import comatchPreview from '../assets/comatch/preview.png';
import communityPreview from '../assets/mcnus/preview.png';
interface Props {
  variant: Project['slug'];
}
const { variant } = Astro.props;
---

<div class:list={['project-art', `project-art-${variant}`]} aria-hidden="true">
  {variant !== 'fittix' && (
    <div
      class:list={[
        'screenshot-preview',
        variant === 'comatch' ? 'comatch-preview' : 'community-preview',
      ]}
    >
      <Image
        src={variant === 'comatch' ? comatchPreview : communityPreview}
        alt=""
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 760px) 100vw, 720px"
        format="webp"
        quality={90}
        loading="lazy"
      />
      <span class="preview-label">
        {variant === 'comatch'
          ? 'COMATCH · APP SCREENSHOT'
          : 'MC@NUS · WEBSITE SCREENSHOT'}
      </span>
    </div>
  )}
  {variant === 'fittix' && (
    <div class="terminal-scene">
      <div class="terminal-window">
        <div class="terminal-bar">
          <div class="browser-dots">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span>fittix — client workspace</span>
          <span>⌘</span>
        </div>
        <div class="terminal-content">
          <span class="terminal-logo">
            fittix<span>_</span>
          </span>
          <p>More coaching. Less clicking.</p>
          <div class="terminal-rule"></div>
          <div class="terminal-command">
            <span>❯</span> find Alex
          </div>
          <div class="terminal-result">
            <span class="terminal-person">AL</span>
            <div>
              <b>Alex Lee</b>
              <span>Client profile · Ready when you are</span>
            </div>
            <span class="terminal-status">ACTIVE</span>
          </div>
          <div class="terminal-command terminal-prompt">
            <span>❯</span> <i></i>
          </div>
          <div class="terminal-hint">
            YOUR NEXT ACTION IS JUST A COMMAND AWAY.
          </div>
        </div>
      </div>
      <div class="keyboard-key">↵</div>
    </div>
  )}
  {variant === 'fittix' && <span class="concept-label">INTERFACE CONCEPT</span>}
</div>

<style>
  .screenshot-preview {
    width: 100%;
    padding: 28px;
    --resting-tilt: -3deg;
    --hover-tilt: -1deg;
  }

  .screenshot-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 10%);
    transform: rotate(var(--resting-tilt));
    transition: transform 450ms ease;
  }

  :global(.art-link:hover) .screenshot-preview img,
  :global(.art-link:focus-visible) .screenshot-preview img {
    transform: rotate(var(--hover-tilt)) translateY(-5px);
  }

  .community-preview {
    max-width: 720px;
    --resting-tilt: 4deg;
    --hover-tilt: 1deg;
  }

  .project-art.project-art-mcnus {
    height: auto;
    min-height: 335px;
  }

  .preview-label {
    display: block;
    margin-top: 24px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  @media (max-width: 760px) {
    .project-art.project-art-comatch,
    .project-art.project-art-mcnus {
      height: auto;
      min-height: 0;
    }

    .screenshot-preview {
      padding: 20px;
    }

    .community-preview {
      padding: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot-preview img {
      transition: none;
    }

    :global(.art-link:hover) .screenshot-preview img,
    :global(.art-link:focus-visible) .screenshot-preview img {
      transform: rotate(var(--resting-tilt));
    }
  }
</style>

---
import type { Project } from '../data/portfolio';
import { Image } from 'astro:assets';
import comatchPreview from '../assets/comatch/preview.png';
interface Props {
  variant: Project['slug'];
}
const { variant } = Astro.props;
---

<div class:list={['project-art', `project-art-${variant}`]} aria-hidden="true">
  {variant === 'comatch' && (
    <div class="comatch-preview">
      <Image
        src={comatchPreview}
        alt=""
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 760px) 100vw, 720px"
        format="webp"
        quality={90}
        loading="lazy"
      />
      <span class="preview-label">COMATCH · APP SCREENSHOT</span>
    </div>
  )}
  {variant === 'fittix' && (
    <div class="terminal-scene">
      <div class="terminal-window">
        <div class="terminal-bar">
          <div class="browser-dots">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span>fittix — client workspace</span>
          <span>⌘</span>
        </div>
        <div class="terminal-content">
          <span class="terminal-logo">
            fittix<span>_</span>
          </span>
          <p>More coaching. Less clicking.</p>
          <div class="terminal-rule"></div>
          <div class="terminal-command">
            <span>❯</span> find Alex
          </div>
          <div class="terminal-result">
            <span class="terminal-person">AL</span>
            <div>
              <b>Alex Lee</b>
              <span>Client profile · Ready when you are</span>
            </div>
            <span class="terminal-status">ACTIVE</span>
          </div>
          <div class="terminal-command terminal-prompt">
            <span>❯</span> <i></i>
          </div>
          <div class="terminal-hint">
            YOUR NEXT ACTION IS JUST A COMMAND AWAY.
          </div>
        </div>
      </div>
      <div class="keyboard-key">↵</div>
    </div>
  )}
  {variant === 'mcnus' && (
    <div class="community-scene">
      <div class="community-window">
        <div class="community-nav">
          <b>
            MC<span>NUS</span>
          </b>
          <span>Our story &nbsp; Events &nbsp; Community</span>
          <i>↗</i>
        </div>
        <div class="community-content">
          <span class="mock-eyebrow">A LITTLE CLOSER TO HOME</span>
          <h3>
            Many stories.
            <br />
            <em>One community.</em>
          </h3>
          <div class="community-shapes">
            <div class="shape-arch">
              <span>✳</span>
            </div>
            <div class="shape-circle">
              <span>မင်္ဂလာပါ</span>
            </div>
            <div class="shape-square">
              <span>↗</span>
            </div>
          </div>
          <div class="community-bottom">
            <span>MYANMAR COMMUNITY AT NUS</span>
            <span>Connected by belonging. ↗</span>
          </div>
        </div>
      </div>
    </div>
  )}
  {variant !== 'comatch' && (
    <span class="concept-label">INTERFACE CONCEPT</span>
  )}
</div>

<style>
  .comatch-preview {
    width: 100%;
    padding: 28px;
  }

  .comatch-preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 10%);
    transform: rotate(-3deg);
    transition: transform 450ms ease;
  }

  :global(.art-link:hover) .comatch-preview img,
  :global(.art-link:focus-visible) .comatch-preview img {
    transform: rotate(-1deg) translateY(-5px);
  }

  .preview-label {
    display: block;
    margin-top: 24px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  @media (max-width: 760px) {
    .project-art.project-art-comatch {
      height: auto;
      min-height: 0;
    }

    .comatch-preview {
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comatch-preview img {
      transition: none;
    }

    :global(.art-link:hover) .comatch-preview img,
    :global(.art-link:focus-visible) .comatch-preview img {
      transform: rotate(-3deg);
    }
  }
</style>

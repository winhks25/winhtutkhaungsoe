---
import Icon from './Icon.astro';
---

<div class="hero-art" aria-hidden="true">
  <div class="art-topline">
    <span>A WORK IN PROGRESS</span>
    <span>↗</span>
  </div>
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>
  <div class="orbit orbit-three"></div>
  <div class="orbit-axis axis-horizontal"></div>
  <div class="orbit-axis axis-vertical"></div>
  <div class="art-spark">
    <svg viewBox="0 0 200 200" fill="none">
      <path
        d="M100 8C104 73 127 96 192 100C127 104 104 127 100 192C96 127 73 104 8 100C73 96 96 73 100 8Z"
        fill="currentColor"
      />
    </svg>
  </div>
  <div class="art-node node-code">
    <Icon name="code" size={24} />
  </div>
  <div class="art-node node-dot">
    <span></span>
  </div>
  <div class="art-note">
    A little curiosity.
    <br />
    <em>A lot of possibility.</em>
  </div>
  <div class="art-code">
    <span class="code-comment">// a simple philosophy</span>
    <br />
    <span class="code-fn">build</span>(&#123;
    <br />
    &nbsp; care: <span class="code-string">'deeply'</span>,<br />
    &nbsp; learn: <span class="code-string">'always'</span>
    <br />
    &#125;);<span class="code-cursor"></span>
  </div>
  <div class="art-bottomline">
    <span>CODE + CURIOSITY + COMMUNITY</span>
    <span>01 — ∞</span>
  </div>
</div>

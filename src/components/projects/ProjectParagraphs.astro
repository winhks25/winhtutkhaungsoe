---
import type { ProjectParagraph } from '../../data/project-details';

interface Props {
  paragraphs: ProjectParagraph[];
}
const { paragraphs } = Astro.props;
---

<div class="project-prose">
  {paragraphs.map((paragraph) => (
    <p>
      {paragraph.map((part) =>
        typeof part === 'string' ? part : <strong>{part.strong}</strong>,
      )}
    </p>
  ))}
</div>

<style>
  .project-prose {
    display: grid;
    gap: 22px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.85;
  }
  strong {
    color: var(--ink);
  }
</style>

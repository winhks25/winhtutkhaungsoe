---
import type { ProjectParagraph } from '../../data/project-details';

interface Props {
  paragraphs: ProjectParagraph[];
  variant?: 'body' | 'lead';
  format?: 'paragraphs' | 'list';
}
const { paragraphs, variant = 'body', format = 'paragraphs' } = Astro.props;
const Container = format === 'list' ? 'ul' : 'div';
const Item = format === 'list' ? 'li' : 'p';
---

<Container
  class:list={[
    'project-prose',
    {
      'project-prose-lead': variant === 'lead',
      'project-prose-list': format === 'list',
    },
  ]}
>
  {paragraphs.map((paragraph) => (
    <Item>
      {paragraph.map((part) =>
        typeof part === 'string' ? (
          part
        ) : 'strong' in part ? (
          <strong>{part.strong}</strong>
        ) : (
          <code>{part.code}</code>
        ),
      )}
    </Item>
  ))}
</Container>

<style>
  .project-prose {
    display: grid;
    gap: 22px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.85;
  }
  strong {
    color: var(--ink);
  }
  .project-prose-list {
    margin: 0;
    padding-left: 22px;
    list-style: disc;
  }
  .project-prose-list > li::marker {
    color: var(--accent);
  }
  code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--ink);
    background: var(--surface);
    padding: 2px 5px;
    border-radius: 3px;
    overflow-wrap: anywhere;
  }
  .project-prose-lead {
    color: var(--ink);
    font-size: 19px;
  }
  @media (max-width: 760px) {
    .project-prose-lead {
      font-size: 18px;
    }
  }
</style>

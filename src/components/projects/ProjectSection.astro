---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="project-section" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <div class="project-section-content">
    <slot />
  </div>
</section>

<style>
  .project-section {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 2fr);
    gap: 48px;
    padding-block: 44px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 23px;
    line-height: 1.45;
    letter-spacing: -0.5px;
  }
  .project-section-content {
    min-width: 0;
  }
  @media (max-width: 760px) {
    .project-section {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-block: 32px;
    }
  }
</style>

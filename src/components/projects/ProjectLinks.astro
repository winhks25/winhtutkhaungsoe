---
import type { ProjectLink } from '../../data/project-details';
import Icon from '../Icon.astro';

interface Props {
  links: ProjectLink[];
}
const { links } = Astro.props;
---

<nav class="project-links" aria-label="Project links">
  {links.map((link) => (
    <a
      class:list={[
        'button',
        link.primary ? 'button-primary' : 'button-outline',
      ]}
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
    >
      {link.label}
      <Icon name="arrow-up-right" size={17} />
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  ))}
</nav>

<style>
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 8px;
  }
  .button {
    gap: 12px;
  }
  @media (max-width: 760px) {
    .project-links {
      width: 100%;
      padding-bottom: 0;
    }
  }
  @media (max-width: 480px) {
    .button {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

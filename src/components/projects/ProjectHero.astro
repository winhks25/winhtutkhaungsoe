---
import { Image } from 'astro:assets';
import type { ProjectHeroContent } from '../../data/project-details';
import ProjectArtwork from '../ProjectArtwork.astro';

interface Props {
  hero: ProjectHeroContent;
}
const { hero } = Astro.props;
---

<figure class="project-hero">
  {'image' in hero ? (
    <Image
      src={hero.image}
      alt={hero.alt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="(max-width: 760px) 100vw, 1180px"
      format="webp"
      quality={90}
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <div class="case-art" role="img" aria-label={hero.alt}>
      <ProjectArtwork variant={hero.artwork} />
    </div>
  )}
</figure>

<style>
  .project-hero {
    margin: 32px 0 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  @media (max-width: 760px) {
    .project-hero {
      padding: 6px;
    }
  }
</style>

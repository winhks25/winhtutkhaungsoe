---
import { Image } from 'astro:assets';
import type { ProjectHeroImage } from '../../data/project-details';

interface Props {
  hero: ProjectHeroImage;
}
const { hero } = Astro.props;
---

<figure class="project-hero">
  <Image
    src={hero.image}
    alt={hero.alt}
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="(max-width: 760px) 100vw, 1180px"
    format="webp"
    quality={90}
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  .project-hero {
    margin: 32px 0 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  @media (max-width: 760px) {
    .project-hero {
      padding: 6px;
    }
  }
</style>
